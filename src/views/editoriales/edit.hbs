<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card shadow-lg border-emerald">
            <div class="card-header border-emerald py-3">
                <div class="d-flex align-items-center">
                    <i class="bi bi-pencil-square text-emerald fs-4 me-2"></i>
                    <div>
                        <h4 class="fw-bold text-white mb-0">Editar Editorial</h4>
                        <span class="text-secondary small">Modifica los datos de contacto y ubicación de la editorial</span>
                    </div>
                </div>
            </div>
            <div class="card-body p-4">
                {{#if error}}
                    <div class="alert alert-danger mb-4 d-flex align-items-center" role="alert">
                        <i class="bi bi-x-circle-fill fs-4 me-2"></i>
                        <div>{{error}}</div>
                    </div>
                {{/if}}

                <form action="/editoriales/edit/{{editorial.id}}" method="POST">
                    <div class="mb-3">
                        <label for="nombre" class="form-label">
                            <i class="bi bi-building text-emerald"></i> Nombre de la Editorial
                        </label>
                        <input type="text" class="form-control" id="nombre" name="nombre" value="{{editorial.nombre}}" required>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label for="telefono" class="form-label">
                                <i class="bi bi-telephone text-emerald"></i> Teléfono
                            </label>
                            <input type="text" class="form-control" id="telefono" name="telefono" value="{{editorial.telefono}}" required>
                        </div>
                        <div class="col-md-6">
                            <label for="pais" class="form-label">
                                <i class="bi bi-globe-americas text-emerald"></i> País
                            </label>
                            <input type="text" class="form-control" id="pais" name="pais" value="{{editorial.pais}}" required>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top border-emerald">
                        <a href="/editoriales" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-emerald px-4">
                            <i class="bi bi-check-lg me-1"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
