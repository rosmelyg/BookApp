<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card shadow-lg border-emerald">
            <div class="card-header border-emerald py-3">
                <div class="d-flex align-items-center">
                    <i class="bi bi-pencil-square text-emerald fs-4 me-2"></i>
                    <div>
                        <h4 class="fw-bold text-white mb-0">Editar Categoría</h4>
                        <span class="text-secondary small">Modifica los datos de la categoría seleccionada</span>
                    </div>
                </div>
            </div>
            <div class="card-body p-4">
                {{#if error}}
                    <div class="alert alert-danger mb-4 d-flex align-items-center" role="alert">
                        <i class="bi bi-x-circle-fill fs-4 me-2"></i>
                        <div>{{error}}</div>
                    </div>
                {{/if}}

                <form action="/categorias/edit/{{categoria.id}}" method="POST">
                    <div class="mb-3">
                        <label for="nombre" class="form-label">
                            <i class="bi bi-type text-emerald"></i> Nombre de la Categoría
                        </label>
                        <input type="text" class="form-control" id="nombre" name="nombre" value="{{categoria.nombre}}" required>
                    </div>

                    <div class="mb-4">
                        <label for="descripcion" class="form-label">
                            <i class="bi bi-card-text text-emerald"></i> Descripción
                        </label>
                        <textarea class="form-control" id="descripcion" name="descripcion" rows="4" required>{{categoria.descripcion}}</textarea>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top border-emerald">
                        <a href="/categorias" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-emerald px-4">
                            <i class="bi bi-check-lg me-1"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
