<div class="row mb-4">
    <div class="col-md-12">
        <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 pb-2 border-bottom border-emerald">
            <div>
                <h1 class="h2 fw-bold text-white mb-1">
                    <i class="bi bi-book-half text-emerald me-2"></i>Catálogo de Libros
                </h1>
                <p class="text-secondary small mb-0">Explora y filtra las obras disponibles en la biblioteca</p>
            </div>
            <div class="mt-2 mt-md-0">
                <span class="badge badge-emerald fs-6 px-3 py-2">
                    <i class="bi bi-collection me-1"></i> {{#if libros.length}}{{libros.length}} libro(s) disponible(s){{else}}0 libros{{/if}}
                </span>
            </div>
        </div>
        
        <!-- Formulario de Búsqueda y Filtros con diseño verde oscuro elegante -->
        <form action="/" method="GET" class="card p-4 shadow-sm mb-4 border-emerald">
            <div class="d-flex align-items-center mb-3 text-emerald fw-semibold">
                <i class="bi bi-funnel-fill me-2 fs-5"></i>
                <span class="text-uppercase tracking-wider" style="letter-spacing: 0.05em; font-size: 0.85rem;">Filtros de Búsqueda Avanzada</span>
            </div>
            <div class="row g-3">
                <div class="col-lg-5 col-md-12">
                    <label for="titulo" class="form-label">
                        <i class="bi bi-search text-emerald"></i> Filtrar por Título
                    </label>
                    <input type="text" class="form-control" id="titulo" name="titulo" value="{{tituloFiltro}}" placeholder="Escribe el título del libro...">
                </div>
                <div class="col-lg-7 col-md-12">
                    <label class="form-label">
                        <i class="bi bi-tags-fill text-emerald"></i> Filtrar por Categoría (selección múltiple):
                    </label>
                    <div class="d-flex flex-wrap gap-2 p-3 border rounded border-emerald" style="max-height: 120px; overflow-y: auto; background-color: var(--input-bg);">
                        {{#each categorias}}
                        <div class="form-check me-2">
                            <input class="form-check-input" type="checkbox" name="categoriaId" value="{{this.id}}" id="cat_{{this.id}}" {{#if this.selected}}checked{{/if}}>
                            <label class="form-check-label text-light" for="cat_{{this.id}}">{{this.nombre}}</label>
                        </div>
                        {{else}}
                        <span class="text-muted small">No hay categorías disponibles</span>
                        {{/each}}
                    </div>
                </div>
                <div class="col-12 d-flex justify-content-end gap-2 pt-2">
                    <a href="/" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i> Limpiar Filtros
                    </a>
                    <button type="submit" class="btn btn-emerald">
                        <i class="bi bi-search"></i> Aplicar Filtros
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Listado de Libros -->
<div class="row g-4">
    {{#if libros.length}}
        {{#each libros}}
            <div class="col-xl-4 col-md-6 col-sm-12">
                <div class="card h-100 book-card shadow-sm border-emerald">
                    <a href="/libro/{{this.id}}" class="text-decoration-none d-block overflow-hidden position-relative" style="background-color: #050a08;">
                        <img src="{{this.portadaUrl}}" class="card-img-top" alt="{{this.titulo}}" style="height: 320px; object-fit: cover; width: 100%;">
                        <div class="position-absolute top-0 end-0 m-2">
                            <span class="badge badge-emerald shadow-sm">
                                <i class="bi bi-tag-fill me-1"></i>{{this.Categoria.nombre}}
                            </span>
                        </div>
                    </a>
                    <div class="card-body d-flex flex-column p-4">
                        <h5 class="card-title fw-bold mb-2">
                            <a href="/libro/{{this.id}}" class="text-white text-decoration-none hover-emerald">{{this.titulo}}</a>
                        </h5>
                        <div class="mb-3 text-secondary small">
                            <div class="d-flex align-items-center mb-1">
                                <i class="bi bi-calendar3 text-emerald me-2"></i>
                                <span class="text-light-50 me-1">Año de publicación:</span>
                                <strong class="text-light">{{this.anoPublicacion}}</strong>
                            </div>
                            <div class="d-flex align-items-center mb-1">
                                <i class="bi bi-person-fill text-emerald me-2"></i>
                                <span class="text-light-50 me-1">Autor:</span>
                                <strong class="text-light">{{this.Autor.nombre}}</strong>
                            </div>
                            <div class="d-flex align-items-center">
                                <i class="bi bi-building text-emerald me-2"></i>
                                <span class="text-light-50 me-1">Editorial:</span>
                                <strong class="text-light">{{this.Editorial.nombre}}</strong>
                            </div>
                        </div>
                        <a href="/libro/{{this.id}}" class="btn btn-outline-emerald mt-auto w-100">
                            <i class="bi bi-eye-fill"></i> Ver Detalle Completo
                        </a>
                    </div>
                </div>
            </div>
        {{/each}}
    {{else}}
        <div class="col-12">
            <div class="card p-5 text-center border-emerald shadow">
                <i class="bi bi-journal-x text-warning fs-1 mb-3"></i>
                <h4 class="text-white fw-bold mb-2">No se encontraron libros</h4>
                <p class="text-secondary mb-4">No hay libros registrados con los criterios de búsqueda seleccionados.</p>
                <div>
                    <a href="/" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-repeat me-1"></i> Restablecer filtros
                    </a>
                </div>
            </div>
        </div>
    {{/if}}
</div>
