<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card shadow-lg border-emerald">
            <div class="card-header border-emerald py-3">
                <div class="d-flex align-items-center">
                    <i class="bi bi-person-plus text-emerald fs-4 me-2"></i>
                    <div>
                        <h4 class="fw-bold text-white mb-0">Registrar Nuevo Autor</h4>
                        <span class="text-secondary small">Ingresa la información del autor para vincularlo a libros</span>
                    </div>
                </div>
            </div>
            <div class="card-body p-4">
                {{#if error}}
                    <div class="alert alert-danger mb-4 d-flex align-items-center" role="alert">
                        <i class="bi bi-x-circle-fill fs-4 me-2"></i>
                        <div>{{error}}</div>
                    </div>
                {{/if}}

                <form action="/autores/create" method="POST">
                    <div class="mb-3">
                        <label for="nombre" class="form-label">
                            <i class="bi bi-person text-emerald"></i> Nombre Completo del Autor
                        </label>
                        <input type="text" class="form-control" id="nombre" name="nombre" value="{{nombre}}" placeholder="Ej. Gabriel García Márquez" required>
                    </div>

                    <div class="mb-4">
                        <label for="correo" class="form-label">
                            <i class="bi bi-envelope text-emerald"></i> Correo Electrónico
                        </label>
                        <input type="email" class="form-control" id="correo" name="correo" value="{{correo}}" placeholder="autor@ejemplo.com" required>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top border-emerald">
                        <a href="/autores" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-emerald px-4">
                            <i class="bi bi-check-circle-fill me-1"></i> Registrar Autor
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
