<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">
        <div class="card shadow-lg border-emerald">
            <div class="card-header border-emerald py-3">
                <div class="d-flex align-items-center">
                    <i class="bi bi-journal-plus text-emerald fs-4 me-2"></i>
                    <div>
                        <h4 class="fw-bold text-white mb-0">Registrar Nuevo Libro</h4>
                        <span class="text-secondary small">Completa los campos para añadir un libro al catálogo</span>
                    </div>
                </div>
            </div>
            <div class="card-body p-4">
                {{#if noPuedeCrear}}
                    <div class="alert alert-warning mb-4 d-flex align-items-center" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-3 me-3 text-warning"></i>
                        <div>
                            <strong>Requisito pendiente:</strong> {{mensajeBloqueo}}
                        </div>
                    </div>
                    <div class="d-flex justify-content-end">
                        <a href="/libros" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Volver a la lista
                        </a>
                    </div>
                {{else}}
                    {{#if error}}
                        <div class="alert alert-danger mb-4 d-flex align-items-center" role="alert">
                            <i class="bi bi-x-circle-fill fs-4 me-2"></i>
                            <div>{{error}}</div>
                        </div>
                    {{/if}}

                    <form action="/libros/create" method="POST">
                        <div class="mb-3">
                            <label for="titulo" class="form-label">
                                <i class="bi bi-type text-emerald"></i> Título del Libro
                            </label>
                            <input type="text" class="form-control" id="titulo" name="titulo" value="{{formData.titulo}}" placeholder="Ej. Cien Años de Soledad" required>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label for="anoPublicacion" class="form-label">
                                    <i class="bi bi-calendar-event text-emerald"></i> Año de Publicación
                                </label>
                                <input type="number" class="form-control" id="anoPublicacion" name="anoPublicacion" value="{{formData.anoPublicacion}}" placeholder="Ej. 1967" required>
                            </div>
                            <div class="col-md-6">
                                <label for="portadaUrl" class="form-label">
                                    <i class="bi bi-image text-emerald"></i> URL de la Portada
                                </label>
                                <input type="url" class="form-control" id="portadaUrl" name="portadaUrl" value="{{formData.portadaUrl}}" placeholder="https://ejemplo.com/portada.jpg" required>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="categoriaId" class="form-label">
                                <i class="bi bi-tag text-emerald"></i> Categoría
                            </label>
                            <select class="form-select" id="categoriaId" name="categoriaId" required>
                                <option value="">-- Seleccione una categoría --</option>
                                {{#each categorias}}
                                    <option value="{{this.id}}">{{this.nombre}}</option>
                                {{/each}}
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="autorId" class="form-label">
                                <i class="bi bi-person text-emerald"></i> Autor
                            </label>
                            <select class="form-select" id="autorId" name="autorId" required>
                                <option value="">-- Seleccione un autor --</option>
                                {{#each autores}}
                                    <option value="{{this.id}}">{{this.nombre}}</option>
                                {{/each}}
                            </select>
                        </div>

                        <div class="mb-4">
                            <label for="editorialId" class="form-label">
                                <i class="bi bi-building text-emerald"></i> Editorial
                            </label>
                            <select class="form-select" id="editorialId" name="editorialId" required>
                                <option value="">-- Seleccione una editorial --</option>
                                {{#each editoriales}}
                                    <option value="{{this.id}}">{{this.nombre}}</option>
                                {{/each}}
                            </select>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top border-emerald">
                            <a href="/libros" class="btn btn-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-emerald px-4">
                                <i class="bi bi-check-circle-fill me-1"></i> Guardar Libro
                            </button>
                        </div>
                    </form>
                {{/if}}
            </div>
        </div>
    </div>
</div>
